# =====================================================================
#  Environment-variable template
# =====================================================================
#  Copy this file to `.env` (which is git-ignored) and fill in the keys
#  you actually need. The minimum for the adversarial robustness study
#  is OPENAI_API_KEY.
# =====================================================================

# --- Required for the adversarial study -------------------------------
# Used by:
#   - the upstream tradingagents pipeline as the agent LLM (gpt-4o-mini)
#   - adversarial/judges/* (absorption + stealth judges)
#   - adversarial/defenses/skeptic_agent.py (Skeptic LLM)
#   - adversarial/attacks/coordinated_disinfo.py (A2 generator default)
#   - the Streamlit demo's "live" tabs (Attack lab, Skeptic)
OPENAI_API_KEY=

# --- Optional: A1 fake-news generator default model -------------------
# adversarial/attacks/news_rewriter.py defaults to claude-sonnet-4-6.
# If you don't have an Anthropic key, pass `--model gpt-4o-mini` to the
# rewriter to fall back to OpenAI.
ANTHROPIC_API_KEY=

# --- Other LLM providers (inherited from upstream, not required) ------
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
